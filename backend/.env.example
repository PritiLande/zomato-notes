# Copy this file to .env and fill in real values. Never commit the real .env file.

# Set to 1 to use mock AI mode (no API key/internet needed) — this is the graded default
MOCK_AI=1

# Only needed if MOCK_AI=0 and you want the optional real LLM path (e.g. Groq free tier)
GROQ_API_KEY=

# Database URL — for local SQLite (default) or Supabase Postgres
# SQLite example:
DATABASE_URL=sqlite:///./zomato_notes.db

# Supabase example (uncomment and fill in if using Supabase instead):
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>

# Simple token required for DELETE /notes/{id}
DELETE_AUTH_TOKEN=changeme123
